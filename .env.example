# Ollama cloud endpoint (from your Ollama cloud dashboard)
OLLAMA_HOST=https://your-ollama-cloud-endpoint

# Ollama API key
OLLAMA_API_KEY=your-api-key-here

# Model to use
OLLAMA_MODEL=gemma3:27b-cloud

# Auth header type: "Bearer" (default) or "x-api-key"
# Try x-api-key if Bearer gives 401
OLLAMA_AUTH_HEADER=Bearer
