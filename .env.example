# Ollama cloud endpoint (from your Ollama cloud dashboard)
OLLAMA_HOST=https://your-ollama-cloud-endpoint

# Ollama API key
OLLAMA_API_KEY=your-api-key-here

# Model to use
OLLAMA_MODEL=gemma3:27b-cloud

# Auth header type: "Bearer" (default) or "x-api-key"
# Try x-api-key if Bearer gives 401
OLLAMA_AUTH_HEADER=Bearer

# YouTube Music Desktop App companion server
YTMD_HOST=http://localhost:9863

# VoiceVox singing (optional — feature is disabled if these are not set)
# Download VoiceVox from https://voicevox.hiroshiba.jp/
# Speaker ID 46 = Mochiko (cute/energetic), see https://voicevox.hiroshiba.jp/
VOICEVOX_HOST=http://localhost:50021
VOICEVOX_SPEAKER=46
